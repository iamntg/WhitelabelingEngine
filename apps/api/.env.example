# ─── Database ────────────────────────────────────────────────────────────────
# Matches docker-compose.yml. Port 5433 avoids clashing with a local Postgres.
DATABASE_URL="postgresql://wl:wl@localhost:5433/whitelabel?schema=public"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated origins allowed to call the authenticated API.
CORS_ORIGINS="http://localhost:5173"

# ─── Auth (Supabase) ─────────────────────────────────────────────────────────
# Project JWT secret, from Supabase → Settings → API → JWT Settings.
# Tokens are verified with HS256 against this value.
SUPABASE_JWT_SECRET="replace-me-with-your-supabase-jwt-secret"

# Expected `aud` claim. Supabase issues "authenticated" for signed-in users.
SUPABASE_JWT_AUDIENCE="authenticated"

# Local development without Supabase. When true (and NODE_ENV is not
# "production"), the API accepts `Authorization: Bearer dev:<userId>` and trusts
# the user id verbatim. Refused outright in production regardless of this flag.
DEV_AUTH_ENABLED=true

# The user id the seed script grants membership to, so `dev:demo-user` works
# against seeded data out of the box.
SEED_USER_ID="demo-user"

# ─── Asset storage ───────────────────────────────────────────────────────────
# Base URL that uploaded logos are served from.
ASSET_PUBLIC_BASE_URL="http://localhost:4000/static/assets"

# Where signed upload URLs point. In development this is the API's own stub
# upload endpoint; in production, point it at your S3/Supabase Storage bucket.
ASSET_UPLOAD_BASE_URL="http://localhost:4000/static/uploads"

# How long a signed upload URL stays valid.
ASSET_UPLOAD_TTL_SECONDS=900

# ─── Public theme cache ──────────────────────────────────────────────────────
PUBLIC_CACHE_MAX_AGE=300
PUBLIC_CACHE_STALE_WHILE_REVALIDATE=86400
