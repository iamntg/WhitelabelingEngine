# The API the app fetches its published theme from.
# On a physical device, localhost is the device itself — use your machine's LAN
# address (e.g. http://192.168.1.117:4000) or a tunnel.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# Which brand this build is for. In production each tenant gets its own build
# with its own slug; in development, point it at any seeded brand:
#   olive-ash-kitchen · fern-fold-studio · palmetto-nail-bar
#
# palmetto-nail-bar has never been published, so it exercises the
# "not published yet" path.
EXPO_PUBLIC_TENANT_SLUG=olive-ash-kitchen
