# Base URL for the API. Leave empty in development — Vite proxies /v1 and
# /public to http://localhost:4000, so requests are same-origin and CORS never
# comes into it. Set this for a deployed build.
VITE_API_BASE_URL=

# Local development user id, sent as `Bearer dev:<id>`. Must match SEED_USER_ID
# in apps/api/.env for the seeded brands to be visible. The API refuses dev
# tokens in production regardless of this value.
VITE_DEV_USER=demo-user
